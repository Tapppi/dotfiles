{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/git-push-guard.sh",
            "if": "Bash(git *)",
            "timeout": 30,
            "statusMessage": "Checking push target"
          }
        ]
      }
    ]
  },
  "pushGuard": {
    "allowAgenticPush": true,
    "remote": "origin",
    "requireWorktree": false
  },
  "permissions": {
    "ask": [
      "Bash(git push *main*)",
      "Bash(git push *master*)",
      "Bash(git -* push *main*)",
      "Bash(git -* push *master*)"
    ]
  }
}
