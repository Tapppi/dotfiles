{
	"$schema": "https://opencode.ai/config.json",
	"plugin": ["oh-my-openagent@latest", "opencode-claude-auth"],
	"skills": {
		"paths": [
			"~/project/github/tapppi/skills/tapppi/browser/skills",
			"~/.claude/plugins/marketplaces/claude-plugins-official/plugins/frontend-design/skills"
		]
	},
	"permission": {
		"skill": {
			"docs": "deny",
			"*/docs": "deny",
			"google-workspace": "deny",
			"*/google-workspace": "deny",
			"chrome-browser": "deny",
			"*/chrome-browser": "deny",
			"built-in-browser": "deny",
			"*/built-in-browser": "deny",
			"computer-use": "deny",
			"*/computer-use": "deny"
		}
	},
	"tui": {
		"scroll_speed": 4,
		"keybinds": {
			"input_submit": "ctrl+l",
			"input_newline": "enter"
		}
	}
}
