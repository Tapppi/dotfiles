{
	"$schema": "https://opencode.ai/config.json",
	"model": "openai/gpt-5.5",
	"small_model": "zai-coding-plan/glm-5.3-flash",
	"skills": {
		"paths": [
			"~/project/github/tapppi/skills/tapppi/browser/skills",
			"~/.claude/plugins/marketplaces/claude-plugins-official/plugins/frontend-design/skills",
			"~/project/github/mantadevoy/ikeh/plugins/ikeh-development/skills"
		]
	},
	"mcp": {
		"context7": {
			"type": "local",
			"command": ["npx", "-y", "@upstash/context7-mcp"]
		}
	},
	"permission": {
		"skill": {
			"docs": "deny",
			"google-workspace": "deny",
			"chrome-browser": "deny",
			"built-in-browser": "deny",
			"computer-use": "deny"
		}
	},
	"tui": {
		"scroll_speed": 4,
		"keybinds": {
			"input_submit": "ctrl+l",
			"input_newline": "enter"
		}
	}
}
