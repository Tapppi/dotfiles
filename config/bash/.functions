#!/usr/bin/env bash

# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$_"
}

# Change working directory to the top-most Finder window location
function cdf() { # short for `cdfinder`
	cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')"
}

# Create a compressed tar archive, using `zstd`, `pigz` or `gzip` for compression
function targz() {
	local tmpFile="${@%/}.tar"
	tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1

	local size
	size=$(stat -f"%z" "${tmpFile}" 2>/dev/null || stat -c"%s" "${tmpFile}" 2>/dev/null)

	local cmd="" ext=""
	if hash zstd 2>/dev/null; then
		cmd="zstd --rm"
		ext=".zst"
	elif hash pigz 2>/dev/null; then
		cmd="pigz"
		ext=".gz"
	else
		cmd="gzip"
		ext=".gz"
	fi

	echo "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…"
	${cmd} -v "${tmpFile}" || return 1

	local zippedSize
	zippedSize=$(stat -f"%z" "${tmpFile}${ext}" 2>/dev/null || stat -c"%s" "${tmpFile}${ext}" 2>/dev/null)

	echo "${tmpFile}${ext} ($((zippedSize / 1000)) kB) created successfully."
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null >/dev/null 2>&1; then
		local arg=-sbh
	else
		local arg=-sh
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@"
	else
		du $arg .[^.]* ./*
	fi
}

# Browse the results of given command in fzf multi mode and open file selections in vim
function fzf_browser() {
	OPENER='if [[ $FZF_SELECT_COUNT -eq 0 ]]; then
	nvim {1} +{2}     # No selection. Open the current line in Vim.
else
	nvim +cw -q {+f}  # Build quickfix list for the selected items.
	fi'

	local reload="$1"
	shift 1
	fzf --disabled --ansi --multi \
		--bind "start:$reload" --bind "change:$reload" \
		--bind "ctrl-e:become:$OPENER" \
		--bind "ctrl-o:execute:$OPENER" \
		--bind 'alt-a:select-all,alt-d:deselect-all,ctrl-/:toggle-preview' \
		--delimiter : \
		--preview 'bat --style=full --color=always {1}' \
		--preview-window '~4,+{2}+4/3,<80(up)' \
		--query "$*"
}
function fzf_browser_lines() {
	OPENER='if [[ $FZF_SELECT_COUNT -eq 0 ]]; then
	nvim {1} +{2}     # No selection. Open the current line in Vim.
else
	nvim +cw -q {+f}  # Build quickfix list for the selected items.
	fi'

	local reload="$1"
	shift 1
	fzf --disabled --ansi --multi \
		--bind "start:$reload" --bind "change:$reload" \
		--bind "ctrl-e:become:$OPENER" \
		--bind "ctrl-o:execute:$OPENER" \
		--bind 'alt-a:select-all,alt-d:deselect-all,ctrl-/:toggle-preview' \
		--delimiter : \
		--preview 'bat --style=full --color=always --highlight-line {2} {1}' \
		--preview-window '~4,+{2}+4/3,<80(up)' \
		--query "$*"
}

# fd->fzf->nvim [QUERY]
function ffv() {
	fzf_browser 'reload:fd --full-path --hidden --color=always {q} || :'
}

# ripgrep->fzf->nvim [QUERY]
function rfv() {
	fzf_browser_lines 'reload:rg --column --color=always --smart-case {q} || :'
}

# Create a data URL from a file
function dataurl() {
	local mimeType=$(file -b --mime-type "$1")
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8"
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')"
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
	local port="${1:-8000}"
	sleep 1 && open "http://localhost:${port}/" &
	python3 -m http.server "$port"
}

# Compare original and gzipped file size
function gz() {
	local origsize=$(wc -c <"$1")
	local gzipsize=$(gzip -c "$1" | wc -c)
	local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l)
	printf "orig: %d bytes\n" "$origsize"
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio"
}

# Run `dig` and display the most useful info
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer
}

# Show all the names (CNs and SANs) listed in the SSL certificate
# for a given domain
function getcertnames() {
	if [ -z "${1}" ]; then
		echo "ERROR: No domain specified."
		return 1
	fi

	local domain="${1}"
	echo "Testing ${domain}…"
	echo "" # newline

	local tmp=$(echo -e "GET / HTTP/1.0\nEOT" |
		openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1)

	if [[ "${tmp}" =~ "-----BEGIN CERTIFICATE-----" ]]; then
		local certText=$(echo "${tmp}" |
			openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
			no_serial, no_sigdump, no_signame, no_validity, no_version")
		echo "Common Name:"
		echo "" # newline
		echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//"
		echo "" # newline
		echo "Subject Alternative Name(s):"
		echo "" # newline
		echo "${certText}" | grep -A 1 "Subject Alternative Name:" |
			sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2
		return 0
	else
		echo "ERROR: Certificate not found."
		return 1
	fi
}

# Normalize `open` across Linux, macOS, and Windows.
# This is needed to make the `o` function (see below) cross-platform.
if [ ! $(uname -s) = 'Darwin' ]; then
	if grep -q Microsoft /proc/version; then
		# Ubuntu on Windows using the Linux subsystem
		alias open='explorer.exe'
	else
		alias open='xdg-open'
	fi
fi

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .
	else
		open "$@"
	fi
}

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX
}

# Start an on-demand recorded Cursor Agent CLI session. Deliberately not wired
# up via `cursor-agent install-shell-integration` — that installs a hook that
# execs `agent record` on every new shell (zsh-only, and it writes straight to
# ~/.zshrc besides), recording terminal activity by default with no documented
# control over what's captured or sent. This gives the same recording only
# when explicitly invoked.
function cursor-record() {
	command -v cursor-agent >/dev/null 2>&1 || { echo "cursor-agent not installed" >&2; return 1; }
	cursor-agent record "$@"
}

# Control the podman machine, which is deliberately left stopped on this laptop.
# Its only long-lived tenant was the kokoro TTS server, and that now lives on
# tmopro18 (see tieto scripts/tts/kokoro-server.sh); an idle libkrun VM with 8
# cores and 19.5GB assigned is not worth carrying on battery for containers used
# a few times a week. Podman Desktop no longer starts it either — its
# `preferences.podman.engine.autostart` is set to false — so container work
# begins with `podvm up`.
function podvm() {
	command -v podman >/dev/null 2>&1 || { echo "podman not installed" >&2; return 1; }
	case "${1:-status}" in
		up|start) podman machine start ;;
		down|stop) podman machine stop ;;
		status) podman machine list ;;
		*) echo "usage: podvm {up|down|status}" >&2; return 1 ;;
	esac
}

# Inspect or force the nix-rosetta-builder Linux VM (systems/hosts/darwin-minimal).
# It runs on-demand: launchd holds localhost:31122 and boots the VM when a Linux
# build connects, and the guest powers itself off after 15 idle minutes. So the
# normal path needs none of this — `nix build --system aarch64-linux …` just
# works, a few seconds slower on a cold VM. These are for when you want to see
# the state, pre-warm before a big build, or reclaim the RAM early.
function builder() {
	local label='system/org.nixos.rosetta-builderd'
	# The VM is a lima guest owned by _rosettabuilder; pgrep -f sees other users'
	# processes, so this identifies it without sudo. Held in one variable because
	# both branches below match on it and a renamed instance must not drift.
	local vm_pattern='hostagent .*rosetta-builder-vm'
	case "${1:-status}" in
		status)
			if pgrep -f "${vm_pattern}" >/dev/null 2>&1; then
				echo "rosetta-builder: VM up"
			else
				echo "rosetta-builder: VM off (wakes itself on the next Linux build)"
			fi
			;;
		# Connecting to the socket is exactly what launchd waits for, so a
		# throwaway probe boots the VM without needing sudo. Poke unconditionally:
		# the hostagent is still alive while the guest is powering itself off, so
		# gating the poke on "is it up?" would silently skip it in exactly the
		# window a pre-warm is meant to cover. The probe is harmless when the VM
		# really is up. A refused connection means the daemon is not loaded, which
		# is worth saying rather than claiming a boot that is not happening.
		up|wake)
			if ! nc -z localhost 31122 >/dev/null 2>&1; then
				echo "no listener on localhost:31122 — is ${label} loaded?" >&2
				return 1
			elif pgrep -f "${vm_pattern}" >/dev/null 2>&1; then
				echo "rosetta-builder: up"
			else
				echo "poked ${label}; VM booting in the background"
			fi
			;;
		down|sleep) sudo launchctl kill TERM "${label}" && echo "sent TERM to ${label}" ;;
		*) echo "usage: builder {status|up|down}" >&2; return 1 ;;
	esac
}
