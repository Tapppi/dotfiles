{
	"version": 1,
	"editor": {
		"vimMode": false
	},
	"approvalMode": "allowlist",
	"notifications": true,
	"hints": true,
	"rewind": false,
	"suggestNextPrompt": false,
	"display": {
		"showLineNumbers": true,
		"showThinkingBlocks": true,
		"showStatusIndicators": true,
		"showStatusLineRunningTime": true
	},
	"attribution": {
		"attributeCommitsToAgent": false,
		"attributePRsToAgent": false
	},
	"permissions": {
		"deny": [
			"Shell(git push)",
			"Shell(terraform apply)",
			"Shell(terraform destroy)",
			"Shell(terraform force-unlock)",
			"Shell(terraform state rm)",
			"Shell(terraform state mv)",
			"Shell(terraform state push)",
			"Shell(make apply)",
			"Shell(make destroy)",
			"Write(**/*.tfstate)",
			"Write(**/*.tfstate.*)",
			"Write(**/backend.tf)",
			"Read(**/.credentials)"
		],
		"allow": [
			"Read(**)",
			"Write(**)",
			"Shell(git)",
			"Shell(mkdir)",
			"Shell(touch)",
			"Shell(mv)",
			"Shell(cp)",
			"Shell(rg)",
			"Shell(find)",
			"Shell(fd)",
			"Shell(tree)",
			"Shell(jq)",
			"Shell(yq)",
			"Shell(duckdb)",
			"Shell(shellcheck)",
			"Shell(npm install)",
			"Shell(npm run test)",
			"Shell(npm run build)",
			"Shell(brew info)",
			"Shell(brew search)",
			"Shell(brew list)",
			"Shell(brew deps)",
			"Shell(brew outdated)",
			"Shell(brew bundle cleanup)",
			"Shell(brew uninstall)",
			"Shell(terraform plan)",
			"Shell(terraform validate)",
			"Shell(terraform fmt)",
			"Shell(terraform init)",
			"Shell(terraform output)",
			"Shell(terraform show)",
			"Shell(terraform providers)",
			"Shell(terraform version)",
			"Shell(terraform workspace list)",
			"Shell(tflint)",
			"Shell(trivy)",
			"Shell(terraform-docs)",
			"Shell(pre-commit run)",
			"Shell(make help)",
			"Shell(make check)",
			"Shell(make fmt)",
			"Shell(make fmt-check)",
			"Shell(make validate)",
			"Shell(make lint)",
			"Shell(make security)",
			"Shell(make docs)",
			"Shell(make list)",
			"Shell(make init)",
			"Shell(make plan)",
			"Shell(make output)",
			"Shell(make command-template)",
			"Shell(gcloud config list)",
			"Shell(gcloud auth list)",
			"Shell(gcloud projects list)",
			"Shell(gcloud projects describe)",
			"Shell(gh status)",
			"Shell(gh repo view)",
			"Shell(gh repo list)",
			"Shell(gh pr list)",
			"Shell(gh pr view)",
			"Shell(gh pr diff)",
			"Shell(gh pr checks)",
			"Shell(gh pr status)",
			"Shell(gh issue list)",
			"Shell(gh issue view)",
			"Shell(gh issue status)",
			"Shell(gh run list)",
			"Shell(gh run view)",
			"Shell(gh run watch)",
			"Shell(gh release list)",
			"Shell(gh release view)",
			"Shell(gh search)",
			"Shell(gh label list)",
			"Shell(gh project list)",
			"Shell(gh project view)",
			"Shell(gh gist list)",
			"Shell(gh gist view)",
			"Shell(gh workflow list)",
			"Shell(gh workflow view)",
			"Shell(gh cache list)",
			"Shell(gh variable list)",
			"Shell(gh secret list)",
			"Shell(gh extension list)",
			"Shell(gh api repos/)",
			"WebFetch(github.com)",
			"WebFetch(raw.githubusercontent.com)",
			"WebFetch(cursor.com)",
			"WebFetch(developer.hashicorp.com)",
			"WebFetch(cloud.google.com)",
			"Mcp(context7:*)",
			"Mcp(chrome-devtools:*)",
			"Mcp(playwright:*)"
		]
	}
}
